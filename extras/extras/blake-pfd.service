[Unit]
Description=Blake PFD
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
WorkingDirectory=%h/Blake-pyEfis

ExecStartPre=/bin/sh -lc 'mkdir -p /tmp/blake_pyefis && rm -f /tmp/blake_pyefis/app.heartbeat && "$HOME/Blake-pyEfis/.venv/bin/python" -c "from time import monotonic; from pathlib import Path; Path('/tmp/blake_pyefis/app.started').write_text(f'{monotonic():.6f}', encoding='utf-8')"'

ExecStart=/bin/sh -lc 'exec "$HOME/Blake-pyEfis/.venv/bin/python" -m pyefis.user.blake_pfd.pfd_demo --hardware'

# Keep attempting recovery, but avoid a rapid CPU-intensive
# restart storm if startup repeatedly fails.
Restart=always
RestartSec=2s

# If the GUI/event loop is truly hung, do not let recovery
# wait on systemd's much longer default shutdown timeout.
TimeoutStopSec=3s
KillMode=control-group

[Install]
WantedBy=default.target
